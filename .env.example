# Port of the SvelteKit server (production: `node build`)
PORT=3000
# Public origin of the server (production), used for correct form/redirect URLs
ORIGIN=http://localhost:3000
# Path to the SQLite database file (created and migrated automatically on start)
DATABASE_URL=./db.sqlite3

# Base URL of the API the frontend talks to. Leave empty for the web build
# (same origin). For the Tauri app build set it to the hosted server, e.g.
# PUBLIC_API_BASE=https://cocktail.kuhlt.de
PUBLIC_API_BASE=

# Only used by `pnpm db:import`: connection to the old Prisma database.
# Either a postgres URL or a path / file: URL to the old SQLite file.
# OLD_DATABASE_URL=postgresql://user:pass@localhost:5432/cocktailcalc
# OLD_DATABASE_URL=file:./old.sqlite3
